# Git & Version Control
.git
.gitignore
.github

# Environment & Secrets (NEVER bake into image)
.env
.env.*
!.env.example

# Local SQLite databases & test caches
*.db
*.db-journal
*.db-wal
veritas.db
test_veritas.db
*.sqlite3

# Python build & bytecode caches
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node & Frontend caches
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Temporary artifacts
.DS_Store
Thumbs.db
*.log
*.pdf
tmp/
