# =====================================================================
# MNB VERITAS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Zero real secrets. Copy to .env and configure for local or staging.
# =====================================================================

# --- Multi-Lab LLM Provider API Keys ---
# Configure at least one provider key. The MoE router automatically routes to active providers
# and trips circuit breakers for unprovisioned labs in 0ms without thread starvation.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here

# --- Local LLM & OpenAI-Compatible Gateways (Ollama / vLLM / LocalAI) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest
DEFAULT_OLLAMA_MODEL=llama3.2:latest
FAST_OLLAMA_MODEL=llama3.2:latest
AUDITOR_OLLAMA_MODEL=llama3.2:latest

# --- Model Selection per Lab (Fast Extraction vs. Deep Auditor) ---
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
FAST_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
AUDITOR_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DEFAULT_OPENAI_MODEL=gpt-4o-mini
FAST_OPENAI_MODEL=gpt-4o-mini
AUDITOR_OPENAI_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o-mini

DEFAULT_GEMINI_MODEL=gemini-3-flash-preview
FAST_GEMINI_MODEL=gemini-3-flash-preview
AUDITOR_GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL=gemini-3-flash-preview

DEFAULT_XAI_MODEL=grok-2
FAST_XAI_MODEL=grok-2
AUDITOR_XAI_MODEL=grok-2
XAI_MODEL=grok-2

# --- Governance, Authentication & Rate Limiting ---
DEFAULT_POLICY_MODE=strict
VERITAS_API_KEY=veritas-local-dev-key-2026
RATE_LIMIT_PER_MINUTE=60

# --- Circuit Breaker Thresholds ---
CB_FAILURE_THRESHOLD=1
CB_COOLDOWN_SECONDS=60.0

# --- Database & In-Memory / Redis Caching ---
# Zero-dependency local development defaults to SQLite:
DATABASE_URL=sqlite+aiosqlite:///./veritas.db
# Enterprise PostgreSQL with pgvector and pg_trgm (e.g. Supabase or RDS):
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@your_host:5432/postgres?ssl=require

REDIS_URL=redis://127.0.0.1:6379/0

# --- Hybrid Retrieval (S2) & Vector Embeddings ---
MAX_CANDIDATE_SOURCES=5
RRF_K=60
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small

# --- Verification Guardrails & Document Limits ---
EXACT_SUBSTRING_REQUIRED=true
MAX_PDF_BYTES=26214400

# --- Compliance & Incident Webhook Alerting (Optional) ---
COMPLIANCE_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL

# --- Supabase Integration (Optional Managed Auth & Telemetry) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Frontend Application (Next.js 15) ---
NEXT_PUBLIC_APP_NAME=MNB Veritas
VERITAS_API_URL=http://127.0.0.1:8000
